# Environment Variables — ResearchPilot AI
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# NEVER put real secrets in this file.
# All values marked YOUR_VALUE_HERE must be replaced.
# ===========================================

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────

# Application environment: development | staging | production
# Required for MVP
APP_ENV=development

# Application version (used in health check response)
# Required for MVP
APP_VERSION=0.1.0

# Backend host and port (for local development)
# Required for MVP
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS origins — comma-separated list of allowed frontend origins (or JSON array)
# Required for Render backend in production: set to your Vercel deployment URL
# (CORS_ORIGINS is also supported as an alias).
# Note: Do not include trailing slashes (e.g. https://your-app.vercel.app).
# Example: https://researchpilot.vercel.app,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional regex for dynamic preview deployments (e.g. Vercel preview branches)
# CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Log level: DEBUG | INFO | WARNING | ERROR
# Required for MVP
LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────────

# Supabase project URL
# Get from: Supabase dashboard → Project Settings → API
# Required for MVP
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase anon key (safe for frontend use)
# Get from: Supabase dashboard → Project Settings → API
# Required for MVP — also used in frontend (see frontend/.env.local)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Supabase service role key (SECRET — NEVER expose to frontend)
# Used by the backend for database writes that bypass RLS
# Get from: Supabase dashboard → Project Settings → API
# Required for MVP
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Supabase JWT secret (used to validate user JWTs on the backend)
# Get from: Supabase dashboard → Project Settings → API → JWT Settings
# Required for MVP
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET_HERE

# Supabase database direct connection URL (for migrations only)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres
# Required for running migrations; not needed for application runtime
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# ─────────────────────────────────────────────
# LLM — PRIMARY PROVIDER (Google Gemini)
# ─────────────────────────────────────────────

# Google Gemini API key
# Get from: https://aistudio.google.com/app/apikey
# Required for MVP
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini model for research agents
# Verified available as of 2026-09 with free tier and structured output support.
# Primary options (free tier): gemini-2.5-flash, gemini-2.5-flash-lite
# Do NOT use: gemini-1.5-flash (deprecated/404), gemini-2.0-flash-exp (shutdown 2026-06)
GEMINI_MODEL=gemini-3.6-flash

# Gemini model for embedding (P1 — needed for RAG document embedding)
# Optional — only required if private document RAG is enabled
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ─────────────────────────────────────────────
# LLM — FALLBACK PROVIDER (Groq)
# ─────────────────────────────────────────────

# Groq API key
# Get from: https://console.groq.com/keys
# Required for MVP (fallback LLM provider)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Groq model to use as fallback
# Verified available as of 2026-09 on Groq free tier with structured output support.
# Use the Groq models API to verify current model IDs: GET https://api.groq.com/openai/v1/models
# Do NOT use: llama-3.3-70b-versatile or llama-3.1-70b-versatile (removed from Groq catalog)
GROQ_MODEL=openai/gpt-oss-20b

# ─────────────────────────────────────────────
# LLM — SECONDARY FALLBACK PROVIDER (OpenRouter)
# ─────────────────────────────────────────────

# OpenRouter API key
# Get from: https://openrouter.ai/keys
# Optional — recommended for production resilience
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# OpenRouter model to use as secondary fallback
OPENROUTER_MODEL=mistralai/mixtral-8x7b-instruct

# ─────────────────────────────────────────────
# LLM ROUTER CONFIGURATION
# ─────────────────────────────────────────────

# Primary LLM provider: gemini | groq | openrouter
# This controls which provider is tried first
# Required for MVP
PRIMARY_LLM_PROVIDER=gemini

# Maximum output tokens per LLM call
# Required for MVP — prevents runaway generation
LLM_MAX_OUTPUT_TOKENS=4096

# LLM call timeout in seconds
# Required for MVP
LLM_TIMEOUT_SECONDS=30

# LLM call retry attempts before switching provider
# Required for MVP
LLM_RETRY_ATTEMPTS=3

# ─────────────────────────────────────────────
# WEB RESEARCH (Tavily)
# ─────────────────────────────────────────────

# Tavily API key for web search and content extraction
# Get from: https://tavily.com (create free account)
# Required for MVP — primary web research tool
# Free tier: verify current limits at https://tavily.com/pricing
TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE

# Maximum results per Tavily search call
# Required for MVP
TAVILY_MAX_RESULTS=5

# Tavily search depth: basic | advanced
# advanced uses more API credits
TAVILY_SEARCH_DEPTH=basic

# ─────────────────────────────────────────────
# RESEARCH PIPELINE — CONCURRENCY
# ─────────────────────────────────────────────

# Maximum number of simultaneous evidence extraction LLM calls.
# The evidence extraction fan-out is parallel; too many concurrent requests
# will hit provider rate limits (HTTP 402 / 429).
# Default of 5 is balanced for free-tier providers (Gemini, Groq, OpenRouter).
# Increase only if you have a paid-tier key with higher rate limits.
# Range: 1–20
EVIDENCE_EXTRACTION_CONCURRENCY=5


# ─────────────────────────────────────────────
# ACADEMIC RESEARCH (P1 — not needed for MVP)
# ─────────────────────────────────────────────

# Semantic Scholar API key
# Get from: https://www.semanticscholar.org/product/api
# Optional — only required if academic_research source type is enabled
# Free tier: public API available without key; key increases rate limits
SEMANTIC_SCHOLAR_API_KEY=

# arXiv does not require an API key
# Rate limit: respect 3 requests/second per arXiv guidelines
# No variable needed

# ─────────────────────────────────────────────
# VECTOR DATABASE (Qdrant — P1, not needed for MVP)
# ─────────────────────────────────────────────

# Qdrant Cloud cluster URL
# Get from: https://cloud.qdrant.io
# Optional — only required if private document RAG is enabled
# Free tier: verify current limits at https://qdrant.tech/pricing/
QDRANT_URL=https://YOUR_CLUSTER_ID.aws.cloud.qdrant.io

# Qdrant API key for authentication
# Get from: Qdrant Cloud dashboard → API Keys
# Optional — required if QDRANT_URL is set
QDRANT_API_KEY=YOUR_QDRANT_API_KEY_HERE

# Qdrant collection name prefix for user document collections
# Collections are named: {prefix}_{user_id}
QDRANT_COLLECTION_PREFIX=researchpilot_user

# ─────────────────────────────────────────────
# OBSERVABILITY (Langfuse)
# ─────────────────────────────────────────────

# Langfuse public key (safe to include in server-side code)
# Get from: https://cloud.langfuse.com → Project Settings → API Keys
# Optional — tracing disabled if not set
# Free tier: verify current limits at https://langfuse.com/pricing
LANGFUSE_PUBLIC_KEY=YOUR_LANGFUSE_PUBLIC_KEY_HERE

# Langfuse secret key (SECRET — backend only)
# Get from: https://cloud.langfuse.com → Project Settings → API Keys
# Optional — required if LANGFUSE_PUBLIC_KEY is set
LANGFUSE_SECRET_KEY=YOUR_LANGFUSE_SECRET_KEY_HERE

# Langfuse host (use cloud.langfuse.com for Langfuse Cloud)
# Optional — defaults to cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# Enable/disable Langfuse tracing (true | false)
# Set to false to disable all tracing without removing keys
LANGFUSE_ENABLED=true

# ─────────────────────────────────────────────
# RESEARCH PIPELINE CONFIGURATION
# ─────────────────────────────────────────────

# Default maximum number of critic verification iterations per session
# Range: 1–3
# Required for MVP
RESEARCH_DEFAULT_MAX_ITERATIONS=2

# Hard cap on critic iterations (enforced by graph, cannot be overridden by user config)
# Required for MVP — prevents infinite loops
RESEARCH_MAX_ITERATIONS_HARD_CAP=3

# Maximum research session duration in seconds
# Sessions exceeding this are marked failed
# Required for MVP
RESEARCH_SESSION_TIMEOUT_SECONDS=300

# Maximum number of concurrent research sessions per user
# Required for MVP
RESEARCH_MAX_CONCURRENT_SESSIONS_PER_USER=3

# Maximum number of sources per research task
# Required for MVP
RESEARCH_MAX_SOURCES_PER_TASK=5

# Maximum number of sub-questions the Planner Agent can generate
# Required for MVP
RESEARCH_MAX_SUB_QUESTIONS=8

# Maximum source content length in tokens before truncation
# Required for MVP — prevents excessive token consumption
RESEARCH_MAX_SOURCE_CONTENT_TOKENS=2000

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────

# Maximum research submissions per user per hour
# Required for MVP
RATE_LIMIT_RESEARCH_PER_HOUR=10

# General API rate limit (requests per minute per user)
# Required for MVP
RATE_LIMIT_API_PER_MINUTE=60

# ─────────────────────────────────────────────
# DOCUMENT UPLOAD (P1 — not needed for MVP)
# ─────────────────────────────────────────────

# Maximum document file size in bytes (default: 10MB)
# Optional — only required if document upload is enabled
DOCUMENT_MAX_FILE_SIZE_BYTES=10485760

# Allowed document MIME types (comma-separated)
# Optional — only required if document upload is enabled
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ─────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────

# Secret key for any application-level signing (e.g., idempotency key hashing)
# Generate with: openssl rand -hex 32
# Required for MVP
APP_SECRET_KEY=YOUR_APP_SECRET_KEY_HERE

# ─────────────────────────────────────────────
# FRONTEND ENVIRONMENT VARIABLES
# (Copy these to frontend/.env.local for the Next.js app)
# ─────────────────────────────────────────────

# Note: Frontend environment variables must be prefixed with NEXT_PUBLIC_ to be exposed to the browser.
# Only SAFE, non-secret values should be NEXT_PUBLIC_.

# Backend API URL (used by Next.js to call FastAPI)
# For local development: http://localhost:8000/api/v1
# For production (Vercel): https://your-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase project URL (same as SUPABASE_URL above)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase anon key (same as SUPABASE_ANON_KEY above — SAFE for frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
