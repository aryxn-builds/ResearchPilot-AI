# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API (FastAPI base URL)
# Local: http://localhost:8000/api/v1
# Production (Vercel): https://your-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1


# Server-only submission origin. Set on Vercel to your Render HTTPS base URL.
# The proxy also supports NEXT_PUBLIC_API_URL above for existing deployments.
RESEARCHPILOT_BACKEND_URL=https://your-backend.onrender.com
# Cold-start budget, bounded to 150 seconds. No automatic POST retries.
RESEARCH_SUBMISSION_TIMEOUT_MS=120000
